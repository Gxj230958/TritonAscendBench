__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.venv/
venv/
.env
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.tox/
*.log

# Triton / NPU caches
.triton/
.cache/
triton-cache/
triton-ascend-cache/
__torch_compile_cache__/

# Tensors / artifacts
*.pt
*.pth
*.pkl
*.safetensors
*.npy
*.npz
*.bin

# Result data (some kept, some not)
results/**/*.raw.json
results/**/temp/
# Per-batch daemon verdict outputs (TaskVerdict JSON); the canonical truth is
# persisted into meta.provenance.golden by auto-apply, so these stay machine-local.
results/**/r10/

# GPU-pipeline transient state: per-step logs + idempotency done-markers
# written by scripts/gpu_pipeline/*. Machine-local, never committed.
results/gpu_pipeline/

# Resolver-verdict cache: a DETERMINISTIC machine-derived artifact
# regenerated by
# `python3 scripts/resolve_upstream_entrypoints.py --refresh-cache`
# under the CURRENT hardened oracle-anchor. NEVER hand-written / never
# committed -- its freshness is verifiable by regenerating + diffing.
results/resolve_all.json

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Submission artifacts
submission_*.tar.gz
# local test/scaffold solutions (provider-only repo)
my_solutions/
solutions/

# External upstream checkouts — NOT benchmark artifacts. The frozen
# per-task kernel.py + triton_ascend_bench/frozen/snapshots/ snapshots (with NOTICE
# attribution) are what ship; the full clones are reproducible.
external/

# Hidden set (never commit)
tasks/**/shapes_hidden.yaml
tasks/_hidden_sealed/

# Tooling output (codex skill runs) — local, not committed
.humanize/

# Design-doc iteration snapshots — local working copies only; the
# authoritative versions are docs/DESIGN.md / docs/ARCHITECTURE-DATAFLOW.md
docs/DESIGN-V*.md
docs/ARCHITECTURE-DATAFLOW-V*.md

# tab_quickstart user config (contains host / GPFS paths -- do not commit)
/tab_quickstart.conf
.tab-quickstart.conf

# Resolver artefacts (user-side runtime output, contain host fingerprint)
/resolve_all.json
/pa_resolve.log
# legacy guard: mailbox is now <bench_parent>/loop_mailbox/;
# this entry remains in case anyone recreates a local .loop/ under bench
/.loop/

# generated R10.a oracle-ref artifacts (regenerated per run)
**/r10_pyref/
triton_ascend_bench/.run_cert

# Sealed anti-cheat canary (maintainer-only; TAB_CANARY_ROOT override)
tasks/_canary/
