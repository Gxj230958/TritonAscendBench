# Release boundary rules for triton-ascend-bench.
#
# `export-ignore` removes the path from `git archive` output (release
# tarball). The bench release artifact MUST NOT contain INTERNAL
# automation, internal plans, internal release docs, or internal test
# files. The same set of patterns is mirrored in `.dockerignore` (Docker
# build context) and in `.github/workflows/ci.yml` (CI release-tarball
# smoke check + bench-core single-direction grep).
#
# Pattern style: directories use a trailing `/`, files use globbing.
# CI verifies the boundary by `git archive | tar t | grep` -- if any new
# INTERNAL artifact lands without an `export-ignore` rule, CI fails.

# INTERNAL orchestrator + GPFS runtime dir
scripts/automation/                              export-ignore
scripts/automation/**                              export-ignore
tab_automation/                                  export-ignore
tab_automation/**                                  export-ignore

# INTERNAL closed-loop orchestration (dev <-> tunnel <-> gpfs <-> GPU)
scripts/loop/                                    export-ignore
scripts/loop/**                                    export-ignore
# INTERNAL dev-only helper scripts (corpus authoring / diagnostics / full
# regression driver) -- not part of the public `tab` surface
scripts/internal/                                export-ignore
scripts/internal/**                                export-ignore

# INTERNAL: the whole infra/ dir is internal now — runner Dockerfiles moved to
# docker/, runtime tables moved to ascendbench/policies/; what remains is the
# scope RFC, upstream contacts, and the provider-side H200 peak table.
infra/                                           export-ignore
infra/**                                           export-ignore

# INTERNAL dev-process docs: impl plans, code/design reviews, triage backlog,
# brainstorms, the automation-subsystem architecture spec, internal release
# runbooks, and the design-stage spec set + rewrite source material under
# docs/internal/. The public docs tree is docs/{DESIGN,ARCHITECTURE,
# kernel-select}.md + docs/reference/ + docs/findings/.
docs/plans/                                      export-ignore
docs/plans/**                                      export-ignore
docs/reviews/                                    export-ignore
docs/reviews/**                                    export-ignore
docs/triage_backlog/                             export-ignore
docs/triage_backlog/**                             export-ignore
docs/brainstorms/                                export-ignore
docs/brainstorms/**                                export-ignore
docs/architecture/                               export-ignore
docs/architecture/**                               export-ignore
docs/release/                                    export-ignore
docs/release/**                                    export-ignore

# INTERNAL tests covering the automation orchestrator + its libraries
tests/unit_tests/test_lib_*.py                   export-ignore
tests/unit_tests/test_*automation*.py            export-ignore
tests/unit_tests/test_fix_orchestrator*.py       export-ignore
tests/unit_tests/test_tier1_reverify*.py         export-ignore
tests/unit_tests/test_extract_verdict*.py        export-ignore
tests/unit_tests/test_llm_client*.py             export-ignore
tests/unit_tests/test_file_blocks*.py            export-ignore
tests/unit_tests/test_queue_lib*.py              export-ignore
tests/unit_tests/test_gpfs_lock*.py              export-ignore
tests/unit_tests/test_ssh_tunnel*.py             export-ignore
tests/unit_tests/test_release_boundary.py        export-ignore
tests/unit_tests/test_prompt_*.py                export-ignore
tests/unit_tests/test_e2e_*.py                   export-ignore
tests/unit_tests/test_backlog_report.py          export-ignore
tests/unit_tests/test_summary_metrics.py         export-ignore
tests/unit_tests/test_bench_evaluator_daemon.py  export-ignore
tests/unit_tests/test_fix_orchestrator_tier2.py  export-ignore
tests/unit_tests/test_fix_orchestrator_m2.py     export-ignore
tests/unit_tests/test_runners.py                 export-ignore
tests/unit_tests/test_tab_quickstart.py          export-ignore
tests/unit_tests/test_r19_boundary.py            export-ignore
tests/unit_tests/test_resolve_loader.py          export-ignore
tests/unit_tests/test_pa_fix1_honest_categories_and_fix3_anchor.py export-ignore
tests/unit_tests/test_schema_doc.py              export-ignore
tests/unit_tests/test_shape_lint_internal.py     export-ignore

# INTERNAL: design-stage specs + dev-process docs not for public release
docs/internal/                                    export-ignore
