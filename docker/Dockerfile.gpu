# GPU baseline runner -- H100 / A100
# Used for: Phase 3.1 GPU triton baseline collection.
#
# The bench runs on the host stack recorded in ascendbench/policies/version_matrix.toml
# [gpu] (torch 2.9.1 / triton 3.5.1 / CUDA 12.6, python 3.12). BASE_IMAGE
# has NO default on purpose: a missing --build-arg makes `docker build`
# fail loudly instead of silently producing an image on the wrong stack.
# Supply a base image that already provides that stack, e.g.:
#   docker build --build-arg BASE_IMAGE=<your torch>=2.9 image> ...
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /workspace
COPY pyproject.toml /workspace/
COPY ascendbench /workspace/ascendbench
COPY tasks /workspace/tasks
COPY scripts /workspace/scripts

# The bench declares only >= lower-bound deps in pyproject.toml; it does
# not pin an exact numerics stack. This installs the bench plus any
# missing dependency and leaves the base image's torch / triton
# untouched.
RUN pip install --no-cache-dir -e ".[dev,gpu]"

# Lock down /tmp at runtime for sandbox tests
ENV TRITON_CACHE_DIR=/runner_cache/triton
ENV HF_HOME=/runner_cache/hf

ENTRYPOINT ["tab"]
